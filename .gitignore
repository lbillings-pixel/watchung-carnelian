# Python
.venv/
__pycache__/

# Large raw downloads (re-fetched by scripts/download_data.py; NJGWS zips are small and kept)
data/raw/dem/*.tif
data/raw/nhd/*.zip
data/raw/nhd/*.gpkg

# Godot caches and build output
godot/.godot/
build/

# Tools (Godot binaries and export templates, ~1.5 GB)
tools/godot/*.zip
tools/godot/*.tpz
tools/godot/*.exe

# Mindat API key (never commit)
tools/mindat_key.txt
.env

# Third-party journal articles (publisher copyright): the PDFs and their text extracts stay local.
# The paper (CC BY 4.0), the USGS paper (public domain) and the NJGWS map sheets are kept. See NEEDED_SOURCES.md.
data/raw/sources/eltabakh1997/
data/raw/sources/puffer2001/
data/raw/sources/rddad2022/
data/raw/sources/steckler1993/

# Local TTS model (300 MB, downloaded separately; see README)
tools/kokoro/

# Screenshots are regenerated by --capture (65 MB a round); the index and the frame-rate sweep are kept
docs/screenshots/*.png

# NJGWS quadrangle extracts (7,000 files, duplicates of the two zips): unzip the zips in place after cloning
data/raw/njgws_24k/dgs10-2/
data/raw/njgws_24k/dgs15-1/

# Working documents kept out of the public repository (user request 2026-11-06)
PROMPT.md
NEEDED_SOURCES.md
REVIEW_GUIDE.md
