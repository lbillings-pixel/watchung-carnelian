extends Node
## Ambient sound and cues (presentation only; ASSUMPTIONS A-G20, A-G23). Loops (assets/ambience, generated by
## scripts/build_ambience.py) are faded each frame toward the levels the current chapter asks for and ducked
## under the narration; one-shots ("cues") are played by the tour's camera flights and by chapter events.
## AppState.ambience_on switches all of it off.

const LOOPS := {   # name -> base volume (dB) at level 1
	"brook": -14.0, "rumble": -10.0, "pressure": -13.0, "grind": -7.0, "weather": -15.0,
	"rush": -9.0, "shimmer": -19.0, "bubble": -12.0,
}
const SHOTS := {   # name -> volume (dB)
	"whoosh_short": -15.0, "whoosh_long": -14.0, "vast": -12.0, "dive": -15.0, "thud": -3.0,
	"settle": -12.0, "glint": -13.0,
}
const DUCK_DB := -7.0

var main: Node
var loops := {}        # name -> AudioStreamPlayer
var _target := {}
var _level := {}
var _boost := {}       # name -> extra dB a chapter asks for (chapter 1 wants its seismic bed loud)
var _shots := {}       # name -> AudioStream
var _pool: Array = []  # one-shot players
var _pool_i := 0
# kept for the older chapter code
var brook: AudioStreamPlayer
var rumble: AudioStreamPlayer


func setup(m: Node) -> void:
	main = m
	for k in LOOPS:
		var p := AudioStreamPlayer.new()
		p.name = k.capitalize()
		var path := "res://assets/ambience/%s.ogg" % k
		if ResourceLoader.exists(path):
			var s: AudioStream = load(path)
			if s is AudioStreamOggVorbis:
				s.loop = true
			p.stream = s
		p.volume_db = -80.0
		add_child(p)
		loops[k] = p
		_target[k] = 0.0
		_level[k] = 0.0
	brook = loops["brook"]
	rumble = loops["rumble"]
	for k in SHOTS:
		var path := "res://assets/ambience/%s.ogg" % k
		if ResourceLoader.exists(path):
			_shots[k] = load(path)
	for i in 4:
		var p := AudioStreamPlayer.new()
		p.name = "Cue%d" % i
		add_child(p)
		_pool.append(p)
	Timeline.chapter_changed.connect(func(_i): clear())


## Chapters call these from set_t: 0..1 per bed.
func set_level(name: String, v: float, boost_db := 0.0) -> void:
	if _target.has(name):
		_target[name] = clampf(v, 0.0, 1.0)
		_boost[name] = boost_db


func set_levels(brook_level: float, rumble_level: float) -> void:
	set_level("brook", brook_level)
	set_level("rumble", rumble_level)


func clear() -> void:
	for k in _target:
		_target[k] = 0.0


## Silence everything now (Stop tour): loops fade out, cues stop.
func stop_all() -> void:
	clear()
	for p in _pool:
		p.stop()


## A one-shot cue (camera swoop, frost crack, ...). `db` is added to the cue's base volume.
func play(name: String, db := 0.0) -> void:
	if not AppState.ambience_on or not _shots.has(name):
		return
	var p: AudioStreamPlayer = _pool[_pool_i % _pool.size()]
	_pool_i += 1
	p.stream = _shots[name]
	p.volume_db = float(SHOTS[name]) + db
	p.play()


func _process(dt: float) -> void:
	var on := AppState.ambience_on
	var duck: float = DUCK_DB if (main != null and main.tour.player.playing) else 0.0
	for k in _target:
		var want: float = _target[k] if on else 0.0
		_level[k] = lerpf(_level[k], want, clampf(dt * 1.5, 0.0, 1.0))
		var p: AudioStreamPlayer = loops[k]
		if p.stream == null:
			continue
		if _level[k] < 0.01:
			if p.playing:
				p.stop()
			continue
		if not p.playing:
			p.play()
		p.volume_db = float(LOOPS[k]) + float(_boost.get(k, 0.0)) + duck + linear_to_db(_level[k])
